# Names and conservative defaults only. Do not commit .env or real credentials.
WISDOMTWIN_ENV=production
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=
RAILWAY_PUBLIC_URL=
DATABASE_URL=
REDIS_URL=
CONNECTOR_TOKEN_KEY=

# One registered public MCP client with exact HTTPS callback URIs (comma-separated).
OAUTH_CLIENT_ID=
OAUTH_REDIRECT_URIS=
# Optional allowlisted client ID metadata documents. ChatGPT: https://chatgpt.com/oauth/client.json
OAUTH_CIMD_CLIENT_IDS=
# Corporate identity provider; register /oauth/callback/identity on the real host.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Enable only after actual provider approvals and an authorized live test.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CONNECTOR_ENABLED=false
SLACK_POLICY_APPROVED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_CONNECTOR_ENABLED=false
DRIVE_CONNECTOR_ENABLED=false
GOOGLE_REVIEW_APPROVED=false

# Backend API inference is separately billed and needs explicit spending approval.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
# Reasoning plus visible output budget for optional Responses mode; separate from query_twin max_tokens.
OPENAI_MAX_OUTPUT_TOKENS=16000
WISDOMTWIN_ALLOW_PAID_MODEL_APIS=false
WISDOMTWIN_GENERATION_MODE=extractive
# Distinct sources one query may re-fetch from Slack or Google.
WISDOMTWIN_MAX_SOURCE_FETCHES=4

# Hosted policy drafts require legal approval and reachable public URLs.
PRIVACY_POLICY_URL=
TERMS_OF_SERVICE_URL=
SUPPORT_URL=
OPENAI_APPS_CHALLENGE=

# Synthetic tests only, with WISDOMTWIN_ENV=local/test and loopback host/origin.
# Never enable through a public tunnel or any public deployment.
WISDOMTWIN_AUTH_DISABLED=false
WISDOMTWIN_USE_FIXTURES=false
WISDOMTWIN_AUTH_DB=
