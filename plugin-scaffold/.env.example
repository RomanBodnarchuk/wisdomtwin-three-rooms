# Copy to .env and fill values in your shell. Do not commit .env.
# Never put real keys in this file.

OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-6.1-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

DATABASE_URL=
REDIS_URL=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CONNECTOR_ENABLED=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_CONNECTOR_ENABLED=false
DRIVE_CONNECTOR_ENABLED=false

CONNECTOR_TOKEN_KEY=
OAUTH_CLIENT_ID=
OAUTH_REDIRECT_URIS=

PUBLIC_BASE_URL=
RAILWAY_PUBLIC_URL=
PRIVACY_POLICY_URL=https://wisdomtwin.ai/privacy
OPENAI_APPS_CHALLENGE=

# Local curl only. Ignored when PUBLIC_BASE_URL is HTTPS.
WISDOMTWIN_AUTH_DISABLED=
WISDOMTWIN_USE_FIXTURES=
